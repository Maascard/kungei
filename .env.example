# ── База данных ──────────────────────────────────────────────
# Локально (Windows): SQLite — ничего настраивать не нужно, оставьте как есть.
# Для продакшена на Vercel укажите строку подключения Postgres (Neon/Supabase).
#
# SQLite (по умолчанию для локального запуска):
DATABASE_URL="file:./dev.db"
#
# PostgreSQL (Neon). Две строки: пул для рантайма и прямое соединение для миграций.
# В Neon → Connect: pooled-строка (с "-pooler" в адресе) и обычная.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ── Админ-панель ─────────────────────────────────────────────
# Логин и пароль для входа в /admin. ОБЯЗАТЕЛЬНО смените пароль!
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-please"

# Секрет для подписи сессии (любая длинная случайная строка, минимум 32 символа)
AUTH_SECRET="please-change-this-to-a-long-random-secret-string"

# ── Загрузка фото (опционально) ──────────────────────────────
# Токен Vercel Blob для загрузки картинок из админки.
# Получить: Vercel → Storage → Blob → создать store → скопировать токен.
# Если не задан — фото можно добавлять по ссылке (URL).
BLOB_READ_WRITE_TOKEN=""

# ── Чат-бот WhatsApp (Claude AI) ─────────────────────────────
# Публичный адрес сайта — бот отправляет эту ссылку клиентам.
SITE_URL="https://example.com"

# Ключ Anthropic API для ответов Claude. Получить: https://console.anthropic.com
ANTHROPIC_API_KEY=""
# Модель бота. По умолчанию самая умная (claude-opus-4-8).
# Для экономии можно поставить claude-haiku-4-5 (быстрее и дешевле).
CHATBOT_MODEL="claude-opus-4-8"

# ── WhatsApp Cloud API (Meta) ────────────────────────────────
# Настройка: developers.facebook.com → создать приложение → WhatsApp.
# Любая придуманная вами строка — её же вписать в настройках webhook в Meta.
WHATSAPP_VERIFY_TOKEN="my-verify-token-change-me"
# Permanent/temporary access token из настроек WhatsApp в Meta.
WHATSAPP_ACCESS_TOKEN=""
# Phone Number ID (НЕ сам номер) из раздела WhatsApp → API Setup.
WHATSAPP_PHONE_NUMBER_ID=""
# App Secret (Settings → Basic) — для проверки подписи входящих запросов. Опционально, но рекомендуется.
WHATSAPP_APP_SECRET=""
# Версия Graph API (можно не менять).
WHATSAPP_GRAPH_VERSION="v21.0"
